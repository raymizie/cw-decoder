# ==========================================
# CW Decoder - Konfigurasi Persekitaran (.env)
# Salin fail ini kepada `.env` dan isi nilai anda
# ==========================================

# --- Pilihan: Laluan FFmpeg (diperlukan untuk OGG/Opus/MP3/M4A dari WhatsApp & Telegram) ---
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# --- Telegram Bot (Polling) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_TIMEOUT=30
# Pilihan: hadkan kepada chat_id tertentu sahaja (dipisahkan dengan koma)
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# --- WhatsApp Webhook (Flask: Meta Cloud API & Twilio) ---
WHATSAPP_PROVIDER=auto
WHATSAPP_HOST=0.0.0.0
WHATSAPP_PORT=5000
WHATSAPP_DEBUG=false

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=cw-decoder-verify-token
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0

# Twilio WhatsApp Sandbox / API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# URL awam HTTPS (cth: https://xxxx.ngrok-free.app) supaya Twilio boleh hantar fail WAV daripada /encode
PUBLIC_BASE_URL=

# --- Keep-Alive Hub (/health untuk UptimeRobot) ---
# Senarai URL servis lain (dipisahkan koma/baris baharu) yang akan di-ping secara automatik apabila /health dipanggil
# KEEPALIVE_URLS=https://servis-1.onrender.com/health,https://servis-2.onrender.com/health
# KEEPALIVE_TIMEOUT_MS=15000
# KEEPALIVE_MIN_INTERVAL_MS=60000
